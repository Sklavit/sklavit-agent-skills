{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/investigate-guard.sh\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "find \"$HOME/.claude/investigate-mode\" -type f -mtime +1 -delete 2>/dev/null || true" }
        ]
      }
    ]
  }
}
